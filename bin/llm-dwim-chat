#!/usr/bin/env raku

use Terminal::ANSI::OO;
use LLM::DWIM;
use Log::Async;

unit sub MAIN(Str :$prompt = "", :$name = 'bot', Bool :$v);

logger.sent-to: $*ERR if $v;

my $agent = dwim-chat($prompt);

while (my $str = prompt t.yellow ~ "you > " ~ t.text-reset ) {
  last unless $str && $str.chars;
  my $res = $agent.eval: $str;
  say t.green ~ "$name > " ~ t.text-reset ~ $res.trim;
}


